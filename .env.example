ADB_SERIAL=
ADB_HOST=127.0.0.1
ADB_PORT=5037

OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gemma:2b
LLM_REQUEST_TIMEOUT_S=60
LLM_TEMPERATURE=0.2

OCR_GPU=false
SCREEN_POLL_INTERVAL_S=1.0

TAP_DELAY_S=0.5
SWIPE_DURATION_MS=300

# --- "mirror" / "mail" workflows ---
MAIL_DEFAULT_RECIPIENT=your.recipient@example.com
MAIL_DEFAULT_SUBJECT=Re-Node: note sent by offline edge agent
MAIL_SUBJECT_FROM_NOTE=true
NOTES_PACKAGE=
CAMERA_PACKAGE=
FRONT_CAMERA_IDS=1
MIRROR_UNKNOWN_FACING_ACTION=tap
UI_WAIT_TIMEOUT_S=12
WORKFLOW_STEP_PAUSE_S=1.0
WIFI_CONNECT_WAIT_S=5
SEND_WAIT_S=5
BRAIN_REASONING_TIMEOUT_S=30
BRAIN_WARMUP=true

# --- timer / alarm ---
CLOCK_PACKAGE=
